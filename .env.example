# =============================================================================
# Any Auto Register - 环境变量配置示例
# =============================================================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 根据实际需求修改配置值
# 3. 不要将 .env 文件提交到 Git
# =============================================================================

# -----------------------------------------------------------------------------
# 服务器配置
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
APP_RUNTIME_DIR=./data

# 开发模式：0=生产模式，1=开发模式 (自动重载)
APP_RELOAD=0

# Conda 环境名称
APP_CONDA_ENV=any-auto-register

# -----------------------------------------------------------------------------
# 验证码服务配置
# -----------------------------------------------------------------------------

# YesCaptcha (可选，使用本地 Solver 时可不填)
# 获取地址：https://yescaptcha.com
YESCAPTCHA_CLIENT_KEY=

# 本地 Solver 配置 (作者默认 camoufox；单线程降低本机资源占用)
LOCAL_SOLVER_URL=http://127.0.0.1:8889
SOLVER_BROWSER_TYPE=camoufox
SOLVER_THREAD=1

# -----------------------------------------------------------------------------
# 代理配置 (可选)
# -----------------------------------------------------------------------------
# 格式：http://username:password@ip:port 或 socks5://ip:port
# 示例：http://user:pass@127.0.0.1:7890
PROXY_URL=

# -----------------------------------------------------------------------------
# 邮箱服务配置 (根据使用的服务填写)
# -----------------------------------------------------------------------------

# MoeMail (默认临时邮箱，自动注册)
MOEMAIL_API_KEY=

# SkyMail / CloudMail
# 获取地址：https://cloudmail.ai
SKYMAIL_API_KEY=
SKYMAIL_DOMAIN=

# TempMail.lol (无需配置)
# 文档：https://tempmail.lol

# LuckMail (Temporary email service)
# Documentation: https://mails.luckyous.com
LUCKMAIL_API_KEY=

# GPTMail
GPTMAIL_API_KEY=

# CF Worker (自建邮箱)
# 参考：https://github.com/dreamhunter2333/cloudflare_temp_email
CFWORKER_API_URL=
CFWORKER_DOMAIN=

# -----------------------------------------------------------------------------
# 外部系统集成 (可选)
# -----------------------------------------------------------------------------
# 推荐运行边界：
# - AutoReg 在宿主机运行
# - CPA/CLIProxyAPI 作为独立稳定服务运行，AutoReg 不接管启停
# - grok2api 由 AutoReg 侧 Docker Compose 托管
# 启动 grok2api：
#   docker compose -f docker-compose.integrations.yml up -d grok2api

# Codex Protocol API (CPA / CLIProxyAPI，独立管理)
CPA_API_URL=http://127.0.0.1:8317
CPA_API_KEY=cliproxyapi
CLIPROXYAPI_BASE_URL=http://127.0.0.1:8317
CLIPROXYAPI_MANAGEMENT_KEY=cliproxyapi

# Sub2API
SUB2API_URL=
SUB2API_KEY=

# grok2api
GROK2API_URL=http://127.0.0.1:8011
GROK2API_APP_KEY=grok2api
GROK2API_API_KEY=
# 写入 CPA OpenAI-compatible 上游时使用，需从独立 CPA 容器可访问。
GROK2API_CPA_URL=http://host.docker.internal:8011
GROK2API_PORT_BIND=8011

# -----------------------------------------------------------------------------
# 其他配置
# -----------------------------------------------------------------------------

# Gmail IMAP 邮箱读取（可选）
# 适合“自有域名 catch-all 转发到 Gmail，再由 AutoReg 读取验证码”的场景。
# Gmail 需要开启两步验证后创建 App Password；不要填写 Gmail 登录密码。
GMAIL_IMAP_EMAIL=
GMAIL_IMAP_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_MAILBOX=INBOX
GMAIL_IMAP_TARGET_EMAIL=
GMAIL_IMAP_TARGET_DOMAIN=

# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 最大并发注册任务数
MAX_CONCURRENT_TASKS=5

# 默认注册重试次数
DEFAULT_RETRY_TIMES=3
